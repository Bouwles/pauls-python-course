{
  "name": "pauls-python-course",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "npm run prepare:assets && next dev",
    "build": "npm run prepare:assets && next build",
    "start": "next start",
    "prepare:assets": "tsx scripts/copy-pyodide.ts && tsx scripts/build-sprites.ts && tsx scripts/build-content.ts",
    "sprites": "tsx scripts/build-sprites.ts",
    "content": "tsx scripts/build-content.ts",
    "validate-content": "tsx scripts/validate-content.ts",
    "test": "vitest run",
    "test:content": "tsx scripts/run-content-tests.ts",
    "test:e2e": "playwright test",
    "lint:copy": "tsx scripts/copy-lint.ts",
    "typecheck": "tsc --noEmit",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "capture:how": "node scripts/capture-how.mjs",
    "test:all": "npm run lint:copy && npm run typecheck && npm test && npm run test:content && npm run test:e2e"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electric-sql/pglite": "^0.5.11",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/python": "^1.1.19",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "marked": "^18.1.1",
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "pyodide": "^314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^5.4.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
