# Copy to .env.local. With nothing set, the app runs on its built-in local
# backend (PGlite in .data/ and email/password sign-in), which is all you need
# for development and tests.

# --- Production (Supabase) -------------------------------------------------
# Auth: email/password, magic link, Google and GitHub (configure the providers
# in the Supabase dashboard; redirect URL: <site>/auth/callback).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: needed to delete accounts.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection for learner data (use the transaction pooler, port 6543).
# Every query runs as the signed-in learner, so the RLS policies apply.
DATABASE_URL=
# Which OAuth buttons to show (comma-separated: google, github).
NEXT_PUBLIC_OAUTH_PROVIDERS=google,github

# --- Site -------------------------------------------------------------------
# The public URL, used in sign-in links.
NEXT_PUBLIC_SITE_URL=

# --- Email ------------------------------------------------------------------
# The opt-in weekly note from Moss. Without a key, nothing is sent in production
# (locally it lands in /dev/mailbox). Sign-in emails come from Supabase.
RESEND_API_KEY=
MAIL_FROM="Moss <moss@your-domain>"
# Vercel Cron sends this as a Bearer token to /api/cron/weekly (see vercel.json).
CRON_SECRET=

# --- GitHub push from the Shelf (optional) -----------------------------------
# A GitHub OAuth app (callback: <site>/api/github/callback) lets learners push
# their Shelf to a new repository. Without these, the Shelf offers the zip only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Tuning -----------------------------------------------------------------
# Minimum seconds on a step before the full solution can be shown.
SOLUTION_MIN_SECONDS=480
# Local backend only: where PGlite keeps its data ("memory" for throwaway runs).
# PPC_DB_DIR=.data/pglite
